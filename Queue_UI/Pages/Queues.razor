@page "/appointments"
@using Queue_UI.Models
@using Queue_UI.Services
@inject IApointmentService AppointmentService
@inject NavigationManager NavigationManager

<h3 class="my-4">Appointments</h3>

@if (appointments == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @foreach (var group in appointments.GroupBy(a => a.StartTime.Date))
    {
        <h4 class="mt-3">@group.Key.ToString("yyyy-MM-dd")</h4>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Group</th>
                    <th>Hall</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in group)
                {
                    <tr>
                        <td>@appointment.UserName</td>
                        <td>@appointment.GroupName</td>
                        <td>@appointment.HallName</td>
                        <td>@appointment.StartTime.ToString("HH:mm")</td>
                        <td>@appointment.EndTime.ToString("HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private IEnumerable<AppointmentDro>? appointments;

    protected override async Task OnInitializedAsync()
    {
        appointments = await AppointmentService.GetAllAppointments();
    }
}
