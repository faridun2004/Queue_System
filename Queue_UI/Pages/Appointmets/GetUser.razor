@page "/User-info"
@using Queue_UI.Models
@using Queue_UI.Services
@inject UserService MyApiService
@inject IHttpAPIProvider _apiProvider

<h3>User information</h3>

@if (userId == null)
{
    <p>Loading......</p>
}
else
{
    <p>Your ID: @userId</p>
    <p>Your Name: @Name</p>
}

@code {
    private Guid? userId;
    UserDto user = new UserDto();
    private string? Name;
    protected override async Task OnInitializedAsync()
    {
        userId = await MyApiService.GetUserIdInToken();
        var response = await _apiProvider.GetAsync<UserDto>($"api/user/{userId}");
        if (response.isSuccessStatusCode)
        {
            user = response.result;
            Name = user.Name ?? string.Empty;
        }
    }
}
