@page "/my-appointments"
@using Queue_UI.Models
@using Queue_UI.Services
@inject ITokenProvider TokenProvider
@inject IHttpAPIProvider _apiProvider
@inject UserService _userProvider
@inject IApointmentService _apointmentService
@inject NavigationManager NavigationManager
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">

<h3 class="text-center my-4">My Appointments</h3>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success text-center">@successMessage</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger text-center">@errorMessage</div>
}

@if (appointments == null)
{
    <p class="text-center"><em>Loading...</em></p>
}
else
{
    @foreach (var group in appointments.GroupBy(a => a.StartTime.Date))
    {
        <h4 class="mt-4">@group.Key.ToString("yyyy-MM-dd")</h4>

        <table class="table table-bordered table-striped">
            <thead class="table-light">
                <tr>
                    <th>Hall</th>
                    <th>Start Time</th>
                    <th>End Time</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in group)
                {
                    <tr>
                        <td>@appointment.HallName</td>
                        <td>@appointment.StartTime.ToString("HH:mm")</td>
                        <td>@appointment.EndTime.ToString("HH:mm")</td>
                        <td>
                            <button @onclick="() => PromptDeleteAppointment(appointment.Id)" class="btn btn-danger btn-sm me-2">
                                <i class="bi bi-trash"></i>
                            </button>
                            <button @onclick="() => EditProduct(appointment.Id)" class="btn btn-primary btn-sm">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (showConfirm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Удаление записи</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                </div>
                <div class="modal-body">
                    <p>Вы уверены, что хотите удалить эту запись?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CancelDelete">Отмена</button>
                    <button class="btn btn-danger" @onclick="ConfirmDelete">Удалить</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private IEnumerable<AppointmentDro>? appointments;
    private string? errorMessage;
    private string? successMessage;

    private bool showConfirm = false;
    private Guid appointmentIdToDelete;

    private void PromptDeleteAppointment(Guid id)
    {
        appointmentIdToDelete = id;
        showConfirm = true;
    }

    private async Task ConfirmDelete()
    {
        try
        {
            await _apointmentService.DeleteAppointment(appointmentIdToDelete);
            successMessage = "Appointment successfully deleted!";
            errorMessage = null;
        }
        catch
        {
            errorMessage = "Ошибка при удалении записи.";
            successMessage = null;
        }
        finally
        {
            showConfirm = false;
            appointmentIdToDelete = Guid.Empty;

            // reload appointments
            await LoadAppointments();
        }
    }

    private void CancelDelete()
    {
        showConfirm = false;
        appointmentIdToDelete = Guid.Empty;
    }

    private void EditProduct(Guid AppointmentId)
    {
        NavigationManager.NavigateTo($"/edit-appointment/{AppointmentId}");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAppointments();
    }

    private async Task LoadAppointments()
    {
        var userId = await _userProvider.GetUserIdInToken();
        if (userId == null)
        {
            errorMessage = "User is not authenticated.";
            return;
        }

        var (isSuccess, result, message) = await _apiProvider.GetAsync<AppointmentDro[]>($"api/appointment/user/{userId}");

        if (isSuccess && result != null)
        {
            appointments = result;
        }
        else
        {
            errorMessage = message ?? "Failed to load appointments.";
        }
    }
}
