@page "/halls"
@using Newtonsoft.Json
@using Queue_UI.Models
@using Queue_UI.Services
@using System.Text
@inject ITokenProvider TokenProvider
@inject HttpClient HttpClient
@inject IHttpAPIProvider _apiProvider
@inject NavigationManager Navigation
@inject UserService UserService

<h3 class="my-4 text-center text-primary">Halls</h3>

@if (halls == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @foreach (var hall in halls)
    {
        <div class="card my-3 shadow-lg">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@hall.Name</h5>
                <div>
                    <button class="btn btn-warning btn-sm me-2" @onclick="() => EditHall(hall.Id)">
                        <i class="bi bi-pencil"></i> <!-- Иконка редактирования -->
                    </button>
                    <button class="btn btn-danger btn-sm" @onclick="() => DeleteHall(hall.Id)">
                        <i class="bi bi-trash"></i> <!-- Иконка удаления -->
                    </button>
                </div>
            </div>
        </div>
    }
    <div class="d-flex justify-content-center my-4">
        <button @onclick="GoToPreviousPage" class="btn btn-outline-primary me-3" disabled="@(!CanGoToPreviousPage)">
            <i class="bi bi-arrow-left-circle"></i> Previous
        </button>
        <span class="align-self-center">Page @currentPage of @totalPages</span>
        <button @onclick="GoToNextPage" class="btn btn-outline-primary ms-3" disabled="@(!CanGoToNextPage)">
            Next <i class="bi bi-arrow-right-circle"></i>
        </button>
    </div>
}

<h3 class="my-4 text-center">Create Hall</h3>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success text-center">@successMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger text-center">@errorMessage</div>
}

<form @onsubmit="HandleSubmit" class="mx-auto w-50">
   

    <div class="form-group mb-3">
        <label for="startTime" class="form-label">Hall Name:</label>
        <input id="startTime" type="text" class="form-control" @bind="hall.Name" required />
    </div>
    <div class="form-group text-center">
        <button type="submit" class="btn btn-primary px-4">Create Hall</button>
    </div>
</form>

@code {
    private IEnumerable<HallDto>? halls;
    private HallDto hall = new HallDto();
    private string? errorMessage;
    private string? successMessage;

    private int currentPage = 1;
    private int pageSize = 5;
    private int totalPages;

    private async Task DeleteHall(Guid hallId)
    {
        successMessage = null;
        errorMessage = null;
        try
        {
            var (isSuccess, _, message) = await _apiProvider.DeleteAsync<object>($"api/Hall/{hallId}");
            if (isSuccess)
            {
                successMessage = "Зал успешно удален!";
                await LoadHalls(); 
            }
            else
            {
                errorMessage = "Невозможно удалить зал. Возможно, он используется в других данных.";
            }
        }
        catch
        {
            errorMessage = "Ошибка при удалении. Попробуйте позже.";
        }
    }
    private void EditHall(Guid HallId)
    {
        Navigation.NavigateTo($"/edit-hall/{HallId.ToString()}");
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadHalls();
        hall.Name = "Hall";
    }

    private async Task LoadHalls()
    {
        var (isSuccess, allAppointments, message) = await _apiProvider.GetAsync<List<HallDto>>("api/hall");

        if (!isSuccess || allAppointments == null || !allAppointments.Any())
        {
            return;
        }

        totalPages = (int)Math.Ceiling((double)allAppointments.Count / pageSize);
        halls = allAppointments.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
    }



    private async Task HandleSubmit()
    {
        successMessage = null;
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(hall.Name))
        {
            errorMessage = "Name cannot be empty.";
            return;
        }

        try
        {
            var (isSuccess, _, message) = await _apiProvider.PostAsync<object>("api/hall", hall);


            if (isSuccess)
            {
                successMessage = "Hall successfully created!";
                errorMessage = null;

                await LoadHalls();

                hall = new HallDto { Name = string.Empty };
            }
            else
            {
                errorMessage = $"Error creating hall: {message}";
                successMessage = null;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error creating hall: {ex.Message}";
            successMessage = null;
        }
    }


    private bool CanGoToPreviousPage => currentPage > 1;
    private bool CanGoToNextPage => currentPage < totalPages;

    private async Task GoToPreviousPage()
    {
        if (CanGoToPreviousPage)
        {
            currentPage--;
            await LoadHalls();
        }
    }

    private async Task GoToNextPage()
    {
        if (CanGoToNextPage)
        {
            currentPage++;
            await LoadHalls();
        }
    }
}
