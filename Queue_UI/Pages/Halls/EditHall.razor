@page "/edit-hall/{id}"
@using Queue_UI.Models
@using Queue_UI.Services
@inject IHttpAPIProvider _apiProvider
@inject NavigationManager Navigation

<h3 class="my-4 text-center text-primary">Редактирование Зала</h3>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success text-center">@successMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger text-center">@errorMessage</div>
}

@if (hall != null)
{
    <form @onsubmit="HandleSubmit" class="mx-auto w-50">
        <div class="form-group mb-3">
            <label for="hallName" class="form-label">Название Зала:</label>
            <input id="hallName" type="text" class="form-control" @bind="hall.Name" required />
        </div>

        <div class="form-group text-center">
            <button type="submit" class="btn btn-primary px-4">Сохранить</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Отмена</button>
        </div>
    </form>
}
else
{
    <p><em>Загрузка...</em></p>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private HallDto? hall;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadHall();
    }

    private async Task LoadHall()
    {
        var (isSuccess, result, message) = await _apiProvider.GetAsync<HallDto>($"api/Hall/{Id}");

        if (isSuccess && result != null)
        {
            hall = result;
        }
        else
        {
            errorMessage = "Ошибка при загрузке зала.";
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        successMessage = null;

        var (isSuccess, _, message) = await _apiProvider.PutAsync<object>("api/Hall", new { id = Id, name = hall!.Name });

        if (isSuccess)
        {
            successMessage = "Зал успешно обновлен!";
            Navigation.NavigateTo("/halls");
        }
        else
        {
            errorMessage = $"Ошибка при обновлении зала: {message}";
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/halls");
    }
}
