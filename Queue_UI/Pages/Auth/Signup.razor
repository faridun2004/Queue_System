@page "/sign-up"
@using Queue_UI.Models
@using Queue_UI.Services
@inject IHttpAPIProvider _apiProvider
@inject NavigationManager navigationManager

<h3>Sign-up</h3>


<form>
    <div class="form-group">
        <label for="FirstName">Name:</label>
        <input class="form-control" @bind="@registerModel.Name" />
    </div>
    <div class="form-group">
        <label for="Role">Role:</label>
        <input class="form-control" @bind="@registerModel.Role" />
    </div>
    <div class="form-group">
        <label for="Username">Username:</label>
        <input id="username" class="form-control" @bind="@registerModel.Username" />
    </div>
    <div class="form-group">
        <label for="Password">Password:</label>
        <input id="password" type="password" class="form-control" @bind="@registerModel.Password" />
    </div>
    <div class="form-group">
        <label for="Group">Group:</label>
        <select class="form-control" @bind="@registerModel.GroupId">
            <option value="">Select Group</option>
            @foreach (var group in groups)
            {
                <option value="@group.Id">@group.Name</option>
            }
        </select>
    </div>
    <div class="form-group">
        <button type="button" class="btn btn-primary" @onclick="Register">Sign-up</button>
        <label>If you already have an account </label>
        <a href="/sign-in">Sign-in</a>
    </div>
</form>

@code {
    private UserDto registerModel = new UserDto();
    private string errorMessage;
    private List<GroupDto> groups = new List<GroupDto>(); 

    protected override async Task OnInitializedAsync()
    {
        var (isSuccessStatusCode, result, message) = await _apiProvider.GetAsync<List<GroupDto>>("api/groups");

        if (isSuccessStatusCode)
        {
            groups = result;
        }
        else
        {
            errorMessage = $"Failed to load groups. Server response: {message}";
        }
    }

    private async Task Register()
    {
        (bool isSuccessStatusCode, string createdUserId, string message) =
            await _apiProvider.PostAsync<string>("api/user", registerModel);

        if (isSuccessStatusCode)
        {
            navigationManager.NavigateTo("/sign-in");
        }
        else
        {
            errorMessage = $"Failed to register user. Server response: {message}";
        }
    }

}