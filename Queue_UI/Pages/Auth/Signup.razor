@page "/sign-up"
@using Queue_UI.Models
@using Queue_UI.Services
@inject IHttpAPIProvider _apiProvider
@inject NavigationManager navigationManager
@inject HttpClient HttpClient

<h3 class="text-center mb-4">Регистрация</h3>
<!-- Bootstrap 5 CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<div class="card shadow-sm p-4 mx-auto" style="max-width: 500px;">
    <form>
        <div class="mb-3">
            <label for="FirstName" class="form-label">Имя:</label>
            <input class="form-control" @bind="@registerModel.Name" placeholder="Введите ваше имя" />
        </div>

        <div class="mb-3">
            <label for="Email" class="form-label">Ключевое слово:</label>
            <input type="text" class="form-control" @bind="@registerModel.KeyWord" placeholder="Введите ключевое слово" />
        </div>

        <div class="mb-3">
            <label for="Username" class="form-label">Имя пользователя:</label>
            <input id="username" class="form-control" @bind="@registerModel.Username" placeholder="Введите имя пользователя" />
        </div>

        <div class="mb-3">
            <label for="Password" class="form-label">Пароль:</label>
            <input id="password" type="password" class="form-control" @bind="@registerModel.Password" placeholder="Введите пароль" />
        </div>

        <div class="mb-3">
            <label for="Group" class="form-label">Группа:</label>
            <select class="form-select" @bind="@registerModel.GroupId" required>
                @if (_groups != null && _groups.Length > 0)
                {
                    @foreach (var group in _groups)
                    {
                        <option value="@group.Id">@group.Name</option>
                    }
                }
                else
                {
                    <option>No groups available</option>
                }
            </select>
        </div>

        <div class="d-grid gap-2 mb-3">
            <button type="button" class="btn btn-primary" @onclick="HandleSubmit">Зарегистрироваться</button>
        </div>

        <div class="text-center">
            <span>Уже есть аккаунт? </span>
            <a href="/sign-in" class="btn btn-link p-0">Войти</a>
        </div>
    </form>
</div>

@code {
    private UserDto registerModel = new UserDto();
    private string? errorMessage;
    private string? successMessage;
    private GroupDto[]? _groups;

    protected override async Task OnInitializedAsync()
    {
        (bool isSuccessStatusCode, _groups, string message) = await _apiProvider.GetAsync<GroupDto[]>("api/groups");
        if (_groups != null && _groups.Length > 0)
        {
            registerModel.GroupId = _groups[0].Id;
        }
        else
        {
            errorMessage = $"Не удалось загрузить группы. Ответ сервера: {message}";
        }
    }

    private async Task HandleSubmit()
    {
        if (registerModel.GroupId == null || registerModel.GroupId == Guid.Empty)
        {
            errorMessage = "Выберите группу перед регистрацией!";
            return;
        }

        var response = await HttpClient.PostAsJsonAsync("api/user", registerModel);
        Console.WriteLine($"Response status: {response.StatusCode}");

        if (response.IsSuccessStatusCode)
        {
            successMessage = "Пользователь успешно зарегистрирован!";
            errorMessage = null;
            navigationManager.NavigateTo("/sign-in");
        }
        else
        {
            errorMessage = "Ошибка при регистрации. Попробуйте снова.";
            successMessage = null;
        }
    }
}
