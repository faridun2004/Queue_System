@page "/forgot-password"
@using Queue_UI.Services
<h3>Восстановление пароля</h3>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-info">
        @Message
    </div>
}

@if (!string.IsNullOrEmpty(NewPassword))
{
    <div class="alert alert-success">
        <strong>Ваш новый пароль: @NewPassword</strong>
    </div>
}
<div class="form-group mb-3">
    <input class="form-control" @bind="UserName" type="text" placeholder="Введите UserName" required>
</div>
<div class="form-group mb-3">
    <input class="form-control" @bind="KeyWord" type="text" placeholder="Введите ключевое слово" required>
</div>

<div class="form-group mb-3">
    <button class="btn btn-primary" @onclick="ForgotPasswords">Отправить</button>
</div>

@code {
    private string KeyWord { get; set; } = string.Empty;
    private string UserName { get; set; } = string.Empty;
    private string Message { get; set; } = string.Empty;
    private string? NewPassword { get; set; }

    [Inject] private IHttpAPIProvider HttpAPIProvider { get; set; } = default!;

    private async Task ForgotPasswords()
    {
        if (string.IsNullOrEmpty(KeyWord) && string.IsNullOrEmpty(UserName))
        {
            Message = "Введите ключевое слово и имя";
            return;
        }

        var payload = new { KeyWord, UserName };

        var response = await HttpAPIProvider.PostAsync<ApiResponse>("api/User/forgot-password", payload);

        if (response.isSuccessStatusCode)
        {
            if (response.result?.NewPassword != null)
            {
                NewPassword = response.result.NewPassword;
                Message = "Инструкция по восстановлению пароля отправлена.";
            }
        }
        else
        {
            Message = $"Ошибка: {response.message}";
        }
    }

    public class ApiResponse
    {
        public string? NewPassword { get; set; }
    }
}
