@page "/sign-in"
@using Queue_UI.Models
@using Queue_UI.Services
@inject ITokenProvider tokenProvider
@inject NavigationManager navigationManager

<h3>Вход на система</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

<form>
    <div class="form-group">
        <label for="username">Username or Email:</label>
        <input id="username" class="form-control" @bind="@loginModel.Username" />
    </div>
    <div class="form-group">
        <label for="password">Password:</label>
        <input id="password" type="password" class="form-control" @bind="@loginModel.Password" />
    </div>
    <div class="form-group">
        <button type="button" class="btn btn-primary" @onclick="Login">Вход</button>
        <label>If you don't have an account </label>
        <button type="button" class="btn btn-link" @onclick="GoToRegister">Регистрация</button>
    </div>
</form>

@code {
    private LoginModel loginModel = new LoginModel();
    private string? errorMessage;

    private void GoToRegister()
    {
        navigationManager.NavigateTo("/sign-up");
    }


    private async Task Login()
    {
        var response = await tokenProvider.LoginAsync(loginModel);
        if (response.IsAuthenticated)
        {
            Console.WriteLine("Navigation to home page after successful login");
            navigationManager.NavigateTo("/", true);
        }
        else
        {
            errorMessage = "Invalid username/email or password.";
            Console.WriteLine("Login failed: " + response.message);
        }
    }
}
