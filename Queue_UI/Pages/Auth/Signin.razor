@page "/sign-in"
@using Queue_UI.Models
@using Queue_UI.Services
@inject ITokenProvider tokenProvider
@inject NavigationManager navigationManager
<!-- Bootstrap 5 CDN -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<h3 class="text-center mb-4">Вход в систему</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<div class="card shadow-sm p-4 mx-auto" style="max-width: 400px;">
    <form>
        <div class="mb-3">
            <label for="username" class="form-label">Username or Email</label>
            <input id="username" class="form-control" @bind="@loginModel.Username" placeholder="Введите ваш логин или email" />
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input id="password" type="password" class="form-control" @bind="@loginModel.Password" placeholder="Введите ваш пароль" />
        </div>

        <div class="d-grid gap-2 mb-3">
            <button type="button" class="btn btn-primary" @onclick="Login">Вход</button>
        </div>

        <div class="d-flex justify-content-between">
            <button type="button" class="btn btn-link p-0" @onclick="GoToRegister">Регистрация</button>
            <button type="button" class="btn btn-link p-0" @onclick="GoToForgotPassword">Забыли пароль?</button>
        </div>
    </form>
</div>

@code {
    private LoginModel loginModel = new LoginModel();
    private string? errorMessage;

    private void GoToRegister()
    {
        navigationManager.NavigateTo("/sign-up");
    }

    private void GoToForgotPassword()
    {
        navigationManager.NavigateTo("/forgot-password");
    }

    private async Task Login()
    {
        var response = await tokenProvider.LoginAsync(loginModel);
        if (response.IsAuthenticated)
        {
            navigationManager.NavigateTo("/", true);
        }
        else
        {
            errorMessage = "Неверный логин или пароль.";
        }
    }
}
