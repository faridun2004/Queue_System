@page "/edit-groups/{id}"
@using Queue_UI.Models
@using Queue_UI.Services
@inject IHttpAPIProvider _apiProvider
@inject NavigationManager Navigation

<h3 class="my-4 text-center text-primary">Edit Gruops</h3>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success text-center">@successMessage</div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger text-center">@errorMessage</div>
}
@if (group != null)
{
    <form @onsubmit="HandleSubmit" class="mx-auto w-50">
        <div class="form-group mb-3">
            <label for="groupname" class="form-label">Название группа:</label>
            <input id="groupname" type="text" class="form-control" @bind="group.Name" required />
        </div>

        <div class="form-group text-center">
            <button type="submit" class="btn btn-primary px-4">Сохранить</button>
            <button type="button" class="btn btn-secondary ms-2" @onclick="GoBack">Отмена</button>
        </div>
    </form>
}
else
{
    <p><em>Загрузка...</em></p>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;
    private GroupDto? group;
    private string? errorMessage;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadGroups();
    }

    private async Task LoadGroups()
    {
        var (isSuccess, result, message) = await _apiProvider.GetAsync<GroupDto>($"api/groups/{Id}");

        if (isSuccess && result != null)
        {
            group = result;
        }
        else
        {
            errorMessage = "Ошибка при загрузке группе.";
        }
    }
    private async Task HandleSubmit()
    {
        errorMessage = null;
        successMessage = null;

        var (isSuccess, _, message) = await _apiProvider.PutAsync<object>("api/groups", new { id = Id, name = group!.Name });

        if (isSuccess)
        {
            successMessage = "Группа успешно обновлен!";
            Navigation.NavigateTo("/groups");
        }
        else
        {
            errorMessage = $"Ошибка при обновлении группе: {message}";
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/groups");
    }
}
