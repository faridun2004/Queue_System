@using Queue_UI.Services
@inject ITokenProvider tokenProvider
@using Microsoft.AspNetCore.Components.Routing
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">HallBooker</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Главная
            </NavLink>
        </div>
       
        @if (tokenProvider.IsAuthenticated)
        {
            <div class="nav-item px-4">
                <NavLink class="nav-link" href="/appointments" Match="NavLinkMatch.All">
                    <span class="bi bi-calendar-event" aria-hidden="true"></span> Бронирование-зала
                </NavLink>
            </div>
            <div class="nav-item px-4">
                <NavLink class="nav-link" href="/my-appointments" Match="NavLinkMatch.All">
                    <span class="bi bi-card-list" aria-hidden="true"></span> Мои-очереди
                </NavLink>
            </div>
        }
        @if (tokenProvider.IsInRole("admin"))
        {
            <div class="nav-item px-4">
                <NavLink class="nav-link" href="/appointments" Match="NavLinkMatch.All">
                    <span class="bi bi-calendar-event" aria-hidden="true"></span> Бронирование-зала
                </NavLink>
            </div>
            <div class="nav-item px-4">
                <NavLink class="nav-link" href="/halls" Match="NavLinkMatch.All">
                    <span class="bi bi-building" aria-hidden="true"></span> Залы
                </NavLink>
            </div>
            <div class="nav-item px-4">
                <NavLink class="nav-link" href="/groups" Match="NavLinkMatch.All">
                    <span class="bi bi-people" aria-hidden="true"></span> Группы
                </NavLink>
            </div>
            <div class="nav-item px-4">
                <NavLink class="nav-link" href="/users" Match="NavLinkMatch.All">
                    <span class="bi bi-person-badge" aria-hidden="true"></span> Пользователи
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {   
        collapseNavMenu = !collapseNavMenu;
    }
}
